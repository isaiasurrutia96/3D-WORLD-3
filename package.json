{
  "name": "letsgo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "LetsGo - a browser based 3D world for free exploration and platforming.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "dev:racing": "npm --prefix apps/letsgo-racing run dev -- --port 5174",
    "build:racing": "npm --prefix apps/letsgo-racing run build",
    "preview:racing": "npm --prefix apps/letsgo-racing run preview -- --port 4174",
    "test:racing": "npm --prefix apps/letsgo-racing run test",
    "build:all": "npm run build && npm --prefix apps/letsgo-racing run build -- --outDir ../../dist/racing --emptyOutDir"
  },
  "dependencies": {
    "three": "0.180.0"
  },
  "devDependencies": {
    "@types/three": "0.180.0",
    "typescript": "5.9.2",
    "vite": "7.1.5"
  }
}
